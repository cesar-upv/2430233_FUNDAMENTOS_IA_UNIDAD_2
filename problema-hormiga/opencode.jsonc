{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "orchestrator",
  "subagent_depth": 1,

  "permission": {
    "bash": {
      "*": "allow",

      "./scripts/fix.sh": "allow",
      "./scripts/check.sh": "allow",

      "uv sync*": "allow",
      "uv run *": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",

      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny"
    },

    "external_directory": "deny"
  }
}
